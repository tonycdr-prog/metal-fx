{
  "name": "@tonycdr-prog/metal-fx",
  "version": "1.1.0",
  "description": "Animated WebGL metal shader effect for React buttons and UI components",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.es.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite --config vite.config.demo.ts",
    "build": "vite build",
    "build:demo": "vite build --config vite.config.demo.ts",
    "deploy": "npm run build:demo && wrangler pages deploy dist-demo --project-name metal-fx-playground",
    "typecheck": "tsc --noEmit",
    "typecheck:demo": "tsc -p demo/tsconfig.json --noEmit",
    "format": "biome check --write .",
    "lint": "biome check . && npm run hygiene",
    "hygiene": "node scripts/check-hygiene.mjs",
    "package:check": "node scripts/check-package.mjs",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:package": "node tests/package/packed-artifact.mjs",
    "audit:prod": "npm audit --omit=dev",
    "release:check": "node scripts/check-release.mjs",
    "check": "npm run lint && npm run typecheck && npm run typecheck:demo && npm run test && npm run build && npm run build:demo && npm run package:check && npm run test:package && npm run audit:prod",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@microsoft/api-extractor": "^7.58.12",
    "@playwright/test": "1.62.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^6.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsdom": "25.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.3.0",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.115.0"
  },
  "keywords": [
    "react",
    "webgl",
    "metal",
    "shader",
    "animation",
    "button",
    "effect",
    "glow"
  ],
  "author": "Jakub Antalik",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonycdr-prog/metal-fx.git"
  },
  "bugs": {
    "url": "https://github.com/tonycdr-prog/metal-fx/issues"
  },
  "homepage": "https://tonycdr-prog.github.io/metal-fx/"
}
